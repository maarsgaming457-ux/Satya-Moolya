# Project Info
PROJECT_NAME="Satya Moolya"
PROJECT_DESCRIPTION="AI-powered marketplace for pre-owned electronics."
API_VERSION="0.1.0"
API_V1_PREFIX="/api/v1"
ENVIRONMENT="production"
LOG_LEVEL="INFO"

# Database Configuration (Supabase PostgreSQL URL)
DATABASE_URL="postgresql+asyncpg://user:password@host:port/dbname"
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Supabase Configuration
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_ANON_KEY="YOUR_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"
SUPABASE_STORAGE_BUCKET="satya mulya"

# AI Integrations
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GROUNDING_DINO_MODEL_ID="IDEA-Research/grounding-dino-base"

# Security & JWT
JWT_SECRET_KEY="YOUR_SECURE_GENERATED_SECRET"
JWT_ALGORITHM="HS256"
JWT_AUDIENCE=""
JWT_ISSUER=""
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS (Frontend URL in production)
CORS_ORIGINS='["https://your-frontend.vercel.app"]'
